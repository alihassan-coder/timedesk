# Copy to .env (never commit .env). Used by `pnpm dev` and `pnpm --filter @timedesk/db db:migrate`.

# Neon connection string: Neon dashboard -> Connect -> pooled connection string
DATABASE_URL=

# Random 32+ characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Where this API is reachable. Local dev default:
BETTER_AUTH_URL=http://localhost:3001

# Where the web app runs (allowed origin for login cookies). Local dev default:
WEB_ORIGIN=http://localhost:5173

# Comma-separated. These emails become admin and are approved automatically when they register. Everyone else waits for approval.
ADMIN_EMAILS=

# Leave empty. Set to true only if the web app and this API are on different sites, for example two separate *.vercel.app
# addresses (browsers block normal login cookies between those). Needs https. Subdomains of one domain are better.
CROSS_SITE_COOKIES=

# Random 32+ characters, used to encrypt AI provider keys at rest. Different from the secret above.
KEY_ENCRYPTION_SECRET=

# Google Calendar (optional). Leave empty to switch the feature off. Create them in the Google Cloud console, see docs/DEPLOY.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <BETTER_AUTH_URL>/v1/integrations/google/callback and must match the redirect address in the console.
GOOGLE_REDIRECT_URI=
